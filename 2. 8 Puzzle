#8 Puzzle

def dls(state, goal, depth, path):
    if state == goal:
        return path

    if depth == 0:
        return None

    zero = state.index(0)
    r, c = divmod(zero, 3)

    moves = [(1,0), (-1,0), (0,1), (0,-1)]

    for dr, dc in moves:
        nr, nc = r + dr, c + dc

        if 0 <= nr < 3 and 0 <= nc < 3:
            new_zero = nr * 3 + nc
            new_state = list(state)

            new_state[zero], new_state[new_zero] = \
                new_state[new_zero], new_state[zero]

            new_state = tuple(new_state)

            result = dls(new_state, goal, depth - 1,
                         path + [new_state])

            if result:
                return result

    return None


start = (2, 8, 3,
         1, 6, 4,
         7, 0, 5)

goal = (1, 2, 3,
        8, 0, 4,
        7, 6, 5)

depth = 10

solution = dls(start, goal, depth, [start])

if solution:
    for state in solution:
        print(state[0:3])
        print(state[3:6])
        print(state[6:9])
        print()
else:
    print("Goal not found")
