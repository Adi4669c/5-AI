import heapq


start = ((2, 8, 3),
         (1, 6, 4),
         (7, 0, 5))

goal = ((1, 2, 3),
        (8, 0, 4),
        (7, 6, 5))

def misplaced_tiles(state):
    count = 0

    for i in range(3):
        for j in range(3):
            if state[i][j] != 0 and state[i][j] != goal[i][j]:
                count += 1

    return count


def get_neighbors(state):
    neighbors = []

    for i in range(3):
        for j in range(3):
            if state[i][j] == 0:
                x, y = i, j

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dx, dy in moves:
        nx, ny = x + dx, y + dy

        if 0 <= nx < 3 and 0 <= ny < 3:
            new_state = [list(row) for row in state]

            new_state[x][y], new_state[nx][ny] = \
                new_state[nx][ny], new_state[x][y]

            neighbors.append(tuple(tuple(row) for row in new_state))

    return neighbors

def print_state(state):
    for row in state:
        print(*row)
    print()

def a_star(start, goal):
    open_list = []
    heapq.heappush(open_list, (0, 0, start))

    g_cost = {start: 0}
    parent = {start: None}

    closed = set()

    while open_list:

        f, g, current = heapq.heappop(open_list)

        if current in closed:
            continue

        closed.add(current)

        if current == goal:
            path = []

            while current is not None:
                path.append(current)
                current = parent[current]

            path.reverse()

            print("Solution Path:")
            print("----------------")

            for depth, state in enumerate(path):
                h = misplaced_tiles(state)
                f = depth + h

                print("Depth =", depth,
                      "h =", h,
                      "f =", f)
                print_state(state)

            print("Total moves:", len(path) - 1)
            return

        for next_state in get_neighbors(current):

            if next_state in closed:
                continue

            new_g = g + 1
            h = misplaced_tiles(next_state)
            new_f = new_g + h

            if next_state not in g_cost or new_g < g_cost[next_state]:

                g_cost[next_state] = new_g
                parent[next_state] = current

                heapq.heappush(
                    open_list,
                    (new_f, new_g, next_state)
                )

    print("No solution found.")
a_star(start, goal)
